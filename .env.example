# Copier vers .env (ignoré par Git), chargé automatiquement en local.
# Dans Docker : docker run --env-file .env ...
# Générer une clé locale sans la publier :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Obligatoire, vide par défaut.
DJANGO_SECRET_KEY=

# Développement local uniquement ; Docker force false.
DJANGO_DEBUG=true

# Hôtes séparés par des virgules.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Port du conteneur ; la plateforme peut le remplacer.
PORT=8000
